{
  "name": "@jorvel/mcp-docs",
  "version": "0.3.0",
  "description": "Model Context Protocol server for the JORVEL docs — list, search, and fetch framework docs from any MCP client.",
  "license": "MIT",
  "homepage": "https://github.com/Ravikisha/JorvelJS#readme",
  "repository": { "type": "git", "url": "https://github.com/Ravikisha/JorvelJS.git", "directory": "packages/mcp-docs" },
  "keywords": ["jorvel", "mcp", "model-context-protocol", "docs", "ai", "claude", "cursor"],
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "bin": { "jorvel-mcp-docs": "./dist/index.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
