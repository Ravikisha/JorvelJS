{
  "name": "jorvel",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:libs": "pnpm -r --filter './libs/**' --filter 'jorvel' build",
    "dev": "pnpm -r --parallel --filter '!jorvel' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:features": "vitest run tests/features",
    "pretest:features": "pnpm -r --filter './libs/**' build",
    "typecheck": "pnpm -r --if-present typecheck",
    "coverage": "pnpm -r --parallel --if-present test:coverage",
    "e2e": "node ./scripts/e2e.mjs",
    "e2e:ci": "cross-env JORVEL_E2E=1 node ./scripts/e2e.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@playwright/test": "^1.54.2",
    "cross-env": "^7.0.3",
    "jsdom": "^28.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.4"
  }
}
