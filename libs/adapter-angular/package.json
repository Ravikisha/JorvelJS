{
  "name": "@jorvel/adapter-angular",
  "version": "0.3.0",
  "description": "Angular adapter for the JORVEL mount contract — expose a standalone Angular component as a framework-neutral mount module.",
  "license": "MIT",
  "homepage": "https://github.com/Ravikisha/JorvelJS#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ravikisha/JorvelJS.git",
    "directory": "libs/adapter-angular"
  },
  "keywords": ["jorvel", "angular", "micro-frontend", "module-federation", "mount", "adapter"],
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jorvel/mount": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "@angular/platform-browser": ">=17.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
